{
    "manifest_version": 3,
    "name": "Media Blocker",
    "version": "1.1",
    "description": "Blocks and blurs images and videos on specified sites with full control.",
    "icons": {
        "16": "icon1.1_16px.png",
        "32": "icon1.1_32px.png",
        "48": "icon1.1_48px.png",
        "128": "icon1.1_128px.png"
    },
    "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
    "background": {
    "service_worker": "service-worker.js"
  },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js", "slider.js"],
        "css": ["styles.css", "buttonsStyle.css"]
      },
      {
        "matches": ["<all_urls>"],
        "js": ["immediateEffect.js"],
        "run_at": "document_start"
      }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon1.1_16px.png",
            "32": "icon1.1_32px.png",
            "48": "icon1.1_48px.png",
            "128": "icon1.1_128px.png"
        }
    },
    "web_accessible_resources": [{
    "resources": ["worker.js"],
    "matches": ["<all_urls>"]
  }]
    
  
}